# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto de la API
PORT=3000

# Credenciales de PostgreSQL (usadas por docker compose para crear la base)
POSTGRES_USER=dsw
POSTGRES_PASSWORD=dsw
POSTGRES_DB=dsw_estacionamiento
POSTGRES_PORT=5432

# Conexion a la base desde tu maquina (sin Docker para la API).
# Dentro de Docker, docker-compose.yml reemplaza el host "localhost" por "db".
DATABASE_URL=postgresql://dsw:dsw@localhost:5432/dsw_estacionamiento?schema=public
